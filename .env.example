# Copy to .env and fill in locally. .env is gitignored. Do not put real
# secrets in this file.

# Helpdesk API bearer token. Required for ticket scripts. No default in source.
NETMON_API_TOKEN=
NETMON_API_URL=http://api.example.com:5000
NETMON_TICKET_PATH=/api/tickets

# Example inventory domain, server subnet, and DNS servers.
NETMON_DOMAIN=example.com
NETMON_SERVER_SUBNET=10.0.0.0/24
NETMON_EXPECTED_DNS=10.0.0.10,10.0.0.20

# SMTP
NETMON_SMTP_HOST=smtp.example.com
NETMON_SMTP_PORT=1025
NETMON_MAIL_FROM=network-monitoring@example.com
NETMON_MAIL_TO=stakeholders@example.com

# SSH logins referenced by network_devices.csv (env:NAME cells).
NETMON_SSH_USER=
NETMON_SSH_PASSWORD=
NETMON_ROUTER_USER=
NETMON_ROUTER_PASSWORD=

# Optional SSH tuning
NETMON_SSH_PORT=22
